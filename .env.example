# BayWheels Station Configuration
# Find your stations at: https://gbfs.lyft.com/gbfs/2.3/bay/en/station_information.json
# Comma-delimited lists (parallel: 1st ID matches 1st short name, etc.)
STATION_IDS=your-station-id-1,your-station-id-2
STATION_SHORT_NAMES=SF-XXX-1,SF-XXX-2

# GBFS API Base URL (usually don't need to change this)
GBFS_BASE_URL=https://gbfs.lyft.com/gbfs/2.3/bay/en

# Node environment (development or production)
NODE_ENV=development

# Bearer token required in Authorization header
BEARER_TOKEN=your-secret-token-here
